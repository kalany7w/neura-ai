{
  "name": "neura-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "db:generate": "pnpm --filter @neura/database generate",
    "db:migrate:dev": "pnpm --filter @neura/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @neura/database migrate:deploy",
    "db:studio": "pnpm --filter @neura/database studio",
    "db:seed": "pnpm --filter @neura/database seed",
    "compose:up": "docker compose -f docker-compose.dev.yml up -d",
    "compose:down": "docker compose -f docker-compose.dev.yml down",
    "compose:logs": "docker compose -f docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
