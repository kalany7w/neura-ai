# ==========================================
# Neura AI — Environment Variables Example
# Copy to .env and fill in (NEVER commit .env)
# ==========================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neura_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host-exposed em dev; container-internal em prod via Coolify) ---
API_PORT=7301
WEB_PORT=7302
WAWORKER_PORT=7303

# --- Observabilidade (opcional) ---
# Webhook Discord/Slack pra alertas: queda de sessão WhatsApp, erros não tratados.
# Sem isto, os alertas só vão pro log (Pino). Discord: URL do webhook do canal.
ALERT_WEBHOOK_URL=
# Sentry (opcional) — error tracking com stack trace. Sem DSN, é no-op nos 3 apps.
SENTRY_DSN=
# Protege GET /metrics (Prometheus) da API. Vazio = aberto (assume rede interna).
METRICS_TOKEN=
# Guard de isolamento multi-tenant: 'true' faz o db LANÇAR quando uma query de
# listagem num modelo tenant roda sem workspaceId (dentro de request). Default
# (vazio/false) = só loga aviso (nunca quebra prod). Ligue em CI/staging pra pegar
# vazamentos cedo, DEPOIS de revisar/limpar os avisos.
TENANT_STRICT=

# --- Limites de recursos dos containers (opcional; defaults no compose) ---
# Teto de memória por app (anti-leak). Ajuste conforme a VPS.
API_MEM_LIMIT=1g
WEB_MEM_LIMIT=1g
WAWORKER_MEM_LIMIT=2g
# Sentry do browser (web). Precisa estar setado no BUILD do web pra ser inlined
# (build arg no Docker), não só no runtime.
NEXT_PUBLIC_SENTRY_DSN=
# Upload de source maps do web (opcional): setar os 3 pra o build subir os maps.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Better Auth ---
# Gerar com: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:7301
TRUSTED_ORIGINS=http://localhost:7302

# --- Encryption (AES-256-GCM pra secrets sensíveis tipo auth state Baileys) ---
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Resend (email transacional: signup confirm, convite agente, reset password) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@neura-ai.net
RESEND_FROM_NAME=Neura AI

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:7301
NEXT_PUBLIC_WS_URL=ws://localhost:7301/ws

# --- Rate Limit ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60

# --- MinIO (usado a partir da Fase 3) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=neura-media
MINIO_USE_SSL=false

# --- Whisper transcription (opcional — vazio desliga transcrição automática de áudio) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_API_BASE=https://api.openai.com/v1
