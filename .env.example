# ==========================================
# Neura AI — Environment Variables Example
# Copy to .env and fill in (NEVER commit .env)
# ==========================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neura_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host-exposed em dev; container-internal em prod via Coolify) ---
API_PORT=7301
WEB_PORT=7302
WAWORKER_PORT=7303

# --- Better Auth ---
# Gerar com: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:7301
TRUSTED_ORIGINS=http://localhost:7302

# --- Encryption (AES-256-GCM pra secrets sensíveis tipo auth state Baileys) ---
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Resend (email transacional: signup confirm, convite agente, reset password) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@neura-ai.net
RESEND_FROM_NAME=Neura AI

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:7301
NEXT_PUBLIC_WS_URL=ws://localhost:7301/ws

# --- Rate Limit ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60

# --- MinIO (usado a partir da Fase 3) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=neura-media
MINIO_USE_SSL=false
