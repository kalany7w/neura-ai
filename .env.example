# ==========================================
# Neura AI — Environment Variables Example
# Copy to .env and fill in (NEVER commit .env)
# ==========================================

# --- Database ---
# Dev local (docker-compose.dev.yml expõe o Postgres em localhost:5432):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neura_ai
# Self-host (docker-compose.selfhost.yml monta a DATABASE_URL sozinho a partir destas):
POSTGRES_USER=neura
POSTGRES_PASSWORD=
POSTGRES_DB=neura_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host-exposed em dev; container-internal em prod via Coolify) ---
API_PORT=7301
WEB_PORT=7302
WAWORKER_PORT=7303

# --- Better Auth ---
# Gerar com: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:7301
TRUSTED_ORIGINS=http://localhost:7302

# --- Encryption (AES-256-GCM pra secrets sensíveis tipo auth state Baileys) ---
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Email (transacional: signup confirm, convite agente, reset password) ---
# Escolha UM provedor. Auto-detect: SMTP_HOST setado → smtp; RESEND_API_KEY → resend.
# Se ambos setados, MAIL_PROVIDER decide (resend|smtp).
MAIL_PROVIDER=

# Opção A — SMTP genérico (qualquer provedor: Gmail, Mailgun, Postal, Mailhog em dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Opção B — Resend (https://resend.com)
RESEND_API_KEY=

# Remetente dos transacionais (obrigatório). RESEND_FROM/RESEND_FROM_NAME são
# aliases aceitos por compatibilidade.
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Neura AI

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:7301
NEXT_PUBLIC_WS_URL=ws://localhost:7301/ws

# --- Rate Limit ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60

# --- MinIO (usado a partir da Fase 3) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=neura-media
MINIO_USE_SSL=false

# --- Whisper transcription (opcional — vazio desliga transcrição automática de áudio) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_API_BASE=https://api.openai.com/v1
