// Neura AI — schema mestre Prisma
// Multi-tenant: toda tabela de domínio tem workspaceId.
// "Workspace" é nossa entidade tenant (NÃO confundir com Better Auth "Account" de OAuth).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT
// ============================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            Membership[]
  invites            Invite[]
  auditLogs          AuditLog[]
  inboxes            Inbox[]
  contacts           Contact[]
  conversations      Conversation[]
  labels             Label[]
  customAttributeDefs CustomAttributeDef[]

  @@map("workspaces")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(AGENT)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(AGENT)
  token       String    @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([workspaceId])
  @@map("invites")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String // e.g. "workspace.created", "invite.sent", "user.role_changed"
  resource    String? // e.g. "Workspace:abc", "Conversation:xyz"
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// BETTER AUTH (tabelas requeridas pelo Better Auth)
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  token             String   @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  // Workspace ativo na sessão (multi-tenant)
  activeWorkspaceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  // OAuth fields
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  // Password fields (Better Auth email/password)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================
// CHANNELS / INBOXES (Fase 2)
// ============================================

enum InboxType {
  WHATSAPP
}

enum InboxStatus {
  DISCONNECTED
  CONNECTING
  AWAITING_QR
  CONNECTED
  BANNED
  ERROR
}

model Inbox {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        InboxType   @default(WHATSAPP)
  status      InboxStatus @default(DISCONNECTED)
  // Configurações flexíveis: padrões de auto-roteamento, default funnel, etc.
  settings    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  waSession     WaSession?
  conversations Conversation[]

  @@index([workspaceId])
  @@index([status])
  @@map("inboxes")
}

model WaSession {
  id      String @id @default(cuid())
  inboxId String @unique
  // Preenchido após conectar (formato E.164 com prefixo "+")
  phoneNumber String?
  // Texto grande criptografado AES-256-GCM (formato iv:tag:ciphertext em hex)
  // Contém credentials.json + keys do Baileys serializados
  encryptedAuthState String? @db.Text
  // QR Code temporário (data URL) — limpo ao conectar
  qrCode             String? @db.Text
  qrExpiresAt        DateTime?
  lastConnectedAt    DateTime?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("wa_sessions")
}

// ============================================
// CONTACTS (Fase 2/5)
// ============================================

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  // Formato E.164 com prefixo "+" (ex: +5511999999999)
  phoneNumber String
  name        String?
  avatarUrl   String?
  // Custom attributes — populado na Fase 5 com defs por workspace
  customAttrs Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  labels        ContactLabel[]

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId])
  @@map("contacts")
}

// ============================================
// CONVERSATIONS + MESSAGES (Fase 2/4)
// ============================================

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String
  inboxId         String
  contactId       String
  status          ConversationStatus @default(OPEN)
  assignedAgentId String?
  lastMessageAt   DateTime?
  unreadCount     Int                @default(0)
  snoozeUntil     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox     Inbox     @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]
  labels    ConversationLabel[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([assignedAgentId])
  @@index([contactId])
  @@index([inboxId])
  @@map("conversations")
}

// ============================================
// LABELS + CUSTOM ATTRIBUTES (Fase 5)
// ============================================

enum LabelScope {
  CONTACT
  CONVERSATION
  BOTH
}

model Label {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  color       String     @default("#94a3b8") // slate-400
  scope       LabelScope @default(BOTH)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactLabels      ContactLabel[]
  conversationLabels ConversationLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model ContactLabel {
  contactId String
  labelId   String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
  @@map("contact_labels")
}

model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
  @@map("conversation_labels")
}

enum CustomAttributeType {
  STRING
  NUMBER
  DATE
  SELECT
}

model CustomAttributeDef {
  id          String              @id @default(cuid())
  workspaceId String
  key         String // identificador estável (snake_case)
  label       String // human-readable
  type        CustomAttributeType @default(STRING)
  options     Json? // SELECT: { values: ["A", "B", "C"] }
  appliesTo   String              @default("CONTACT") // CONTACT, CONVERSATION
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_attribute_defs")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  // ID retornado pelo Baileys (key.id) — único por sessão/jid
  waMessageId    String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String?          @db.Text
  // Preenchido pra mídia (Fase 3 vai apontar pro MinIO)
  mediaUrl       String?
  mediaMimeType  String?
  mediaSize      Int?
  // Resposta a outra mensagem (replied_to no Baileys)
  replyToId      String?
  status         MessageStatus    @default(PENDING)
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([waMessageId])
  @@map("messages")
}
