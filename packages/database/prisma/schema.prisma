// Neura AI — schema mestre Prisma
// Multi-tenant: toda tabela de domínio tem workspaceId.
// "Workspace" é nossa entidade tenant (NÃO confundir com Better Auth "Account" de OAuth).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT
// ============================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Settings flexíveis do workspace: automationsPaused, defaultGreeting, etc.
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             Membership[]
  invites             Invite[]
  auditLogs           AuditLog[]
  inboxes             Inbox[]
  contacts            Contact[]
  conversations       Conversation[]
  labels              Label[]
  customAttributeDefs CustomAttributeDef[]
  funnels             Funnel[]
  cards               Card[]
  messageTemplates    MessageTemplate[]
  webhooks            Webhook[]
  automationRules     AutomationRule[]
  notifications       Notification[]
  apiKeys             ApiKey[]
  scheduledMessages   ScheduledMessage[]

  @@map("workspaces")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(AGENT)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(AGENT)
  token       String    @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([workspaceId])
  @@map("invites")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String // e.g. "workspace.created", "invite.sent", "user.role_changed"
  resource    String? // e.g. "Workspace:abc", "Conversation:xyz"
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// BETTER AUTH (tabelas requeridas pelo Better Auth)
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  token             String   @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  // Workspace ativo na sessão (multi-tenant)
  activeWorkspaceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  // OAuth fields
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  // Password fields (Better Auth email/password)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================
// CHANNELS / INBOXES (Fase 2)
// ============================================

enum InboxType {
  WHATSAPP
}

enum InboxStatus {
  DISCONNECTED
  CONNECTING
  AWAITING_QR
  CONNECTED
  BANNED
  ERROR
}

model Inbox {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        InboxType   @default(WHATSAPP)
  status      InboxStatus @default(DISCONNECTED)
  // Configurações flexíveis: padrões de auto-roteamento, default funnel, etc.
  settings    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  waSession     WaSession?
  conversations Conversation[]

  @@index([workspaceId])
  @@index([status])
  @@map("inboxes")
}

model WaSession {
  id      String @id @default(cuid())
  inboxId String @unique
  // Preenchido após conectar (formato E.164 com prefixo "+")
  phoneNumber String?
  // Texto grande criptografado AES-256-GCM (formato iv:tag:ciphertext em hex)
  // Contém credentials.json + keys do Baileys serializados
  encryptedAuthState String? @db.Text
  // QR Code temporário (data URL) — limpo ao conectar
  qrCode             String? @db.Text
  qrExpiresAt        DateTime?
  lastConnectedAt    DateTime?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("wa_sessions")
}

// ============================================
// CONTACTS (Fase 2/5)
// ============================================

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  // Formato E.164 com prefixo "+" (ex: +5511999999999)
  phoneNumber String
  name        String?
  avatarUrl   String?
  // Custom attributes — populado na Fase 5 com defs por workspace
  customAttrs Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  labels        ContactLabel[]

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId])
  @@map("contacts")
}

// ============================================
// CONVERSATIONS + MESSAGES (Fase 2/4)
// ============================================

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String
  inboxId         String
  contactId       String
  status          ConversationStatus @default(OPEN)
  assignedAgentId String?
  lastMessageAt   DateTime?
  unreadCount     Int                @default(0)
  snoozeUntil     DateTime?
  // Arquivada: removida das views padrão mas mantida (vs delete)
  archivedAt      DateTime?
  // Último agente que enviou OUTBOUND nesta conversa (cache pra lista)
  lastAgentRepliedId String?
  // Preview da última msg (qualquer direção) — cache pra lista
  lastMessagePreview String?         @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox     Inbox               @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]
  labels    ConversationLabel[]
  notes     ConversationNote[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, archivedAt])
  @@index([assignedAgentId])
  @@index([contactId])
  @@index([inboxId])
  @@map("conversations")
}

// ============================================
// CONVERSATION NOTES + TEMPLATES (Fase 4 follow-up)
// ============================================

model ConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

model MessageTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  // Atalho tipo /saudacao
  shortcut    String?
  // Suporta placeholders {{contact.name}}, {{contact.phoneNumber}}
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("message_templates")
}

// ============================================
// LABELS + CUSTOM ATTRIBUTES (Fase 5)
// ============================================

enum LabelScope {
  CONTACT
  CONVERSATION
  BOTH
}

model Label {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  color       String     @default("#94a3b8") // slate-400
  scope       LabelScope @default(BOTH)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactLabels      ContactLabel[]
  conversationLabels ConversationLabel[]
  cardLabels         CardLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model ContactLabel {
  contactId String
  labelId   String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
  @@map("contact_labels")
}

model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
  @@map("conversation_labels")
}

enum CustomAttributeType {
  STRING
  NUMBER
  DATE
  SELECT
}

model CustomAttributeDef {
  id          String              @id @default(cuid())
  workspaceId String
  key         String // identificador estável (snake_case)
  label       String // human-readable
  type        CustomAttributeType @default(STRING)
  options     Json? // SELECT: { values: ["A", "B", "C"] }
  appliesTo   String              @default("CONTACT") // CONTACT, CONVERSATION
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_attribute_defs")
}

// ============================================
// KANBAN (Fase 6)
// ============================================

model Funnel {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  color         String   @default("#3b82f6")
  order         Int      @default(0)
  isDefault     Boolean  @default(false)
  // SLA limiares (segundos sem resposta agente) — override do default
  slaThresholds Json? // { yellow: 900, red: 1800, blink: 3600 }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  cards     Card[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("funnels")
}

enum StageOutcome {
  POSITIVE // ganho — outcome final positivo (substitui isWon)
  NEGATIVE // perda — outcome final negativo (substitui isLost)
  RISK     // risco — alerta, card continua ativo (não fecha)
}

model Stage {
  id        String        @id @default(cuid())
  funnelId  String
  name      String
  color     String        @default("#94a3b8")
  order     Int           @default(0)
  outcome   StageOutcome?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  cards  Card[]

  @@index([funnelId])
  @@map("stages")
}

model Card {
  id                 String    @id @default(cuid())
  workspaceId        String
  funnelId           String
  stageId            String
  conversationId     String?
  title              String
  description        String?   @db.Text
  value              Decimal?  @db.Decimal(12, 2)
  currency           String    @default("USD")
  assignedAgentId    String?
  dueDate            DateTime?
  startDate          DateTime?
  position           Int       @default(0)
  customAttrs        Json?
  // SLA derivado — recalculado periodicamente
  slaStatus          String    @default("green") // green/yellow/red/blink
  lastAgentReplyAt   DateTime?
  // Última msg da conversa (cache pra preview no card)
  lastMessagePreview String?   @db.Text
  lastMessageAt      DateTime?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnel    Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stage     Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  labels    CardLabel[]
  products  CardProduct[]
  snoozes   CardSnooze[]
  notes     CardNote[]

  @@index([workspaceId])
  @@index([funnelId, stageId, position])
  @@index([conversationId])
  @@index([assignedAgentId])
  @@index([slaStatus])
  @@map("cards")
}

model CardLabel {
  cardId    String
  labelId   String
  createdAt DateTime @default(now())

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model CardProduct {
  id        String   @id @default(cuid())
  cardId    String
  name      String
  price     Decimal? @db.Decimal(12, 2)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("card_products")
}

model CardSnooze {
  id            String    @id @default(cuid())
  cardId        String
  snoozeUntil   DateTime
  reason        String?
  reactivatedAt DateTime?
  createdAt     DateTime  @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([snoozeUntil])
  @@map("card_snoozes")
}

model CardNote {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@map("card_notes")
}

// ============================================
// SAVED FILTERS (Fase 8)
// ============================================

model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  query       Json // serialização dos filtros
  context     String // 'inbox' ou 'kanban'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, workspaceId, context, name])
  @@index([userId])
  @@map("saved_filters")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum TranscriptionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  // ID retornado pelo Baileys (key.id) — único por sessão/jid
  waMessageId    String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String?          @db.Text
  // Preenchido pra mídia (Fase 3 vai apontar pro MinIO)
  mediaUrl       String?
  mediaMimeType  String?
  mediaSize      Int?
  // Thumbnail 240x240 gerado pra imagens (sharp) — usado em preview/inbox
  thumbnailUrl   String?
  // Resposta a outra mensagem (replied_to no Baileys)
  replyToId      String?
  status         MessageStatus    @default(PENDING)
  // Transcrição (preenchido pra AUDIO via Whisper, fire-and-forget)
  transcription       String?              @db.Text
  transcriptionStatus TranscriptionStatus?
  // Edição: editedAt preenchido quando agente reedita conteúdo (Baileys edit API).
  // deletedAt preenchido quando msg foi revogada ("apagar pra todos") — content fica null/placeholder.
  editedAt       DateTime?
  deletedAt      DateTime?
  // Mensagem encaminhada — referência opcional à msg original (mesmo workspace).
  // Cliente WhatsApp NÃO marca como forwarded ao receber (só envia conteúdo).
  forwardedFromId String?
  // Location messages (Baileys locationMessage) — campos opcionais.
  locationLat    Float?
  locationLon    Float?
  locationName   String?
  locationAddress String?
  // Pin de mensagem na conversa (apenas interno — não propaga pro WhatsApp).
  // pinnedAt + pinnedBy permite N msgs pinadas, ordenadas por pinnedAt desc.
  pinnedAt       DateTime?
  pinnedBy       String?
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([waMessageId])
  @@map("messages")
}

model MessageReaction {
  id          String   @id @default(cuid())
  messageId   String
  emoji       String
  fromMe      Boolean  @default(true) // true = enviado por agente nosso
  createdBy   String?  // userId que reagiu (null = vindo do cliente)
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, fromMe])
  @@index([messageId])
  @@map("message_reactions")
}

// ============================================
// API KEYS (Bearer pra integrações externas)
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String    // ex 'nk_live_abc12345' — visível pro user identificar
  hashed      String    @unique // SHA-256 do segredo completo
  scopes      String[]  @default([])
  enabled     Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

// ============================================
// SCHEDULED MESSAGES (envios agendados)
// ============================================

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id             String                 @id @default(cuid())
  workspaceId    String
  conversationId String
  scheduledFor   DateTime
  type           MessageType            @default(TEXT)
  content        String?                @db.Text
  mediaUrl       String?
  mediaMimeType  String?
  fileName       String?
  status         ScheduledMessageStatus @default(PENDING)
  sentMessageId  String?                // Message.id criado ao disparar
  failedReason   String?                @db.Text
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status, scheduledFor])
  @@map("scheduled_messages")
}

// ============================================
// WEBHOOKS (Integrações externas — n8n, Zapier, etc.)
// ============================================

model Webhook {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  url         String
  events      String[] // ['message.new', 'conversation.created', 'card.moved', ...]
  secret      String?  // pra assinar payload com HMAC-SHA256
  enabled     Boolean   @default(true)
  lastFiredAt DateTime?
  lastStatus  Int?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("webhooks")
}

// ============================================
// AUTOMATION RULES (regras "se X então Y")
// ============================================

model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  trigger     String   // 'conversation.created' | 'message.new' | 'card.moved' | ...
  conditions  Json     // [{ field: 'message.text', op: 'contains', value: 'preço' }, ...]
  actions     Json     // [{ kind: 'assign_agent', userId: 'xxx' }, ...]
  enabled     Boolean  @default(true)
  priority    Int      @default(0) // maior = roda primeiro
  runCount    Int      @default(0)
  lastFiredAt DateTime?
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, trigger, enabled])
  @@map("automation_rules")
}

// ============================================
// NOTIFICATIONS (sino do topbar)
// ============================================

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  kind        String   // 'message.new' | 'conversation.assigned' | 'sla.critical' | 'card.outcome'
  title       String
  body        String?  @db.Text
  link        String?  // ex: /inbox/abc123
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}
