// Neura AI — schema mestre Prisma
// Multi-tenant: toda tabela de domínio tem workspaceId.
// "Workspace" é nossa entidade tenant (NÃO confundir com Better Auth "Account" de OAuth).

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// TENANT
// ============================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Settings flexíveis do workspace: automationsPaused, defaultGreeting, etc.
  settings  Json?
  aiAgentName       String  @default("Agente IA")
  aiAgentAvatarUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             Membership[]
  invites             Invite[]
  auditLogs           AuditLog[]
  inboxes             Inbox[]
  contacts            Contact[]
  conversations       Conversation[]
  labels              Label[]
  customAttributeDefs CustomAttributeDef[]
  funnels             Funnel[]
  cards               Card[]
  messageTemplates    MessageTemplate[]
  webhooks            Webhook[]
  inboundWebhooks     InboundWebhook[]
  automationRules     AutomationRule[]
  automationRuns      AutomationRun[]
  slaPolicies         SlaPolicy[]
  notifications       Notification[]
  apiKeys             ApiKey[]
  scheduledMessages   ScheduledMessage[]
  kbCategories        KbCategory[]
  kbArticles          KbArticle[]
  csatSurveys         CsatSurvey[]
  csatResponses       CsatResponse[]
  welcomeFlows        WelcomeFlow[]

  @@map("workspaces")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(AGENT)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(AGENT)
  token       String    @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([workspaceId])
  @@map("invites")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String // e.g. "workspace.created", "invite.sent", "user.role_changed"
  resource    String? // e.g. "Workspace:abc", "Conversation:xyz"
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// BETTER AUTH (tabelas requeridas pelo Better Auth)
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  notifications Notification[]

  welcomeOptionsTargetingMe WelcomeOption[] @relation("WelcomeOptionTargetUser")
  welcomeFlowsFallbackToMe  WelcomeFlow[]   @relation("WelcomeFlowFallbackUser")

  @@map("users")
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  token             String   @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  // Workspace ativo na sessão (multi-tenant)
  activeWorkspaceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  // OAuth fields
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  // Password fields (Better Auth email/password)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================
// CHANNELS / INBOXES (Fase 2)
// ============================================

enum InboxType {
  WHATSAPP
  TELEGRAM
  EMAIL
  WEBCHAT
}

enum InboxStatus {
  DISCONNECTED
  CONNECTING
  AWAITING_QR
  CONNECTED
  BANNED
  ERROR
}

model Inbox {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        InboxType   @default(WHATSAPP)
  status      InboxStatus @default(DISCONNECTED)
  // Configurações flexíveis: padrões de auto-roteamento, default funnel, etc.
  settings    Json?
  // Config específica do canal (criptografada quando contém secrets).
  // TELEGRAM: { botTokenEncrypted, botUsername, botId, webhookSlug }
  // EMAIL: { fromAddress, resendDomain, inboundSlug }
  channelConfig Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  waSession     WaSession?
  conversations Conversation[]
  welcomeFlow   WelcomeFlow?

  @@index([workspaceId])
  @@index([status])
  @@map("inboxes")
}

model WaSession {
  id      String @id @default(cuid())
  inboxId String @unique
  // Preenchido após conectar (formato E.164 com prefixo "+")
  phoneNumber String?
  // Texto grande criptografado AES-256-GCM (formato iv:tag:ciphertext em hex)
  // Contém APENAS Baileys creds (noiseKey, signedIdentityKey, registrationId, me.id, etc.).
  // Signal keys (pre-key, session, sender-key, app-state-sync-key) vão em WaAuthKey —
  // 1 row por key, write-through sem debounce, igual ao padrão use-multi-file-auth-state
  // do Baileys. Evita Bad MAC: keys defasadas no disco quando o processo morre.
  encryptedAuthState String? @db.Text
  // QR Code temporário (data URL) — limpo ao conectar
  qrCode             String? @db.Text
  qrExpiresAt        DateTime?
  lastConnectedAt    DateTime?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("wa_sessions")
}

// Signal keys do Baileys, 1 row por key. PK composta (inboxId, keyName) garante
// upsert atômico por key — sem janela de perda como acontecia com o blob debounced.
// keyName = `${type}-${id}` (ex: "pre-key-1", "session-5511999999999@s.whatsapp.net").
// keyData = JSON.stringify(value, BufferJSON.replacer), criptografado AES-256-GCM.
model WaAuthKey {
  inboxId String
  keyName String
  keyData String   @db.Text
  updatedAt DateTime @updatedAt

  @@id([inboxId, keyName])
  @@index([inboxId])
  @@map("wa_auth_keys")
}

// ============================================
// CONTACTS (Fase 2/5)
// ============================================

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  // Formato E.164 com prefixo "+" (ex: +5511999999999). Pra Telegram pode ser null
  // se contato só veio via Telegram (cliente sem phone visível no Bot API).
  phoneNumber String?
  // Identificador único por canal: chat.id do Telegram (string pra suportar negativos de grupos).
  telegramChatId String?
  // Email pra inbox tipo EMAIL — ID externo do contato.
  email          String?
  // Session token opaco pra inboxes tipo WEBCHAT — random 32 hex gerado no widget.
  // Persiste no localStorage do browser pra reuso de sessão.
  webchatSessionId String?
  name        String?
  avatarUrl   String?
  // Custom attributes — populado na Fase 5 com defs por workspace
  customAttrs Json?
  welcomeRespondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  labels        ContactLabel[]
  notes         ContactNote[]
  csatResponses CsatResponse[]

  @@unique([workspaceId, phoneNumber])
  @@unique([workspaceId, telegramChatId])
  @@unique([workspaceId, email])
  @@unique([workspaceId, webchatSessionId])
  @@index([workspaceId])
  @@map("contacts")
}

// Notas long-term em um contato (separadas de ConversationNote / CardNote).
// Persistem mesmo se conversas/cards forem fechados/arquivados/excluídos.
// Visíveis pra todos os roles do workspace; autor ou ADMIN podem editar/excluir.
model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@map("contact_notes")
}

// ============================================
// CONVERSATIONS + MESSAGES (Fase 2/4)
// ============================================

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String
  inboxId         String
  contactId       String
  status          ConversationStatus @default(OPEN)
  assignedAgentId String?
  lastMessageAt   DateTime?
  unreadCount     Int                @default(0)
  snoozeUntil     DateTime?
  // Arquivada: removida das views padrão mas mantida (vs delete)
  archivedAt      DateTime?
  // Último agente que enviou OUTBOUND nesta conversa (cache pra lista)
  lastAgentRepliedId String?
  // Preview da última msg (qualquer direção) — cache pra lista
  lastMessagePreview String?         @db.Text
  // Timestamp da última msg INBOUND (cliente). Usado pra filtro "aguardando resposta".
  lastInboundAt      DateTime?
  // Timestamp da última msg OUTBOUND (agente/auto). Se < lastInboundAt → aguardando resposta.
  lastOutboundAt     DateTime?
  // SLA: timestamp + tempo (segundos) da primeira resposta de agente.
  // Set ao criar primeira OUTBOUND msg (idempotente — só se null).
  firstResponseAt    DateTime?
  firstResponseSeconds Int?
  // SLA: timestamp + tempo (segundos) até resolução (status → RESOLVED).
  // Set quando status vira RESOLVED (idempotente).
  resolvedAt         DateTime?
  resolutionSeconds  Int?
  // SLA: marcador anti-duplicação de breach notification. Set quando scheduler
  // detecta breach FRT e cria notification — evita re-notificar mesma conversa.
  slaBreachNotifiedAt DateTime?
  // IA Copilot: classificação automática (intent + urgency + sentiment + confidence)
  // Schema: { intent: 'sale'|'support'|'complaint'|'info'|'other', urgency: 'low'|'medium'|'high'|'critical', sentiment: 'positive'|'neutral'|'negative', confidence: 0-1, classifiedAt: ISO }
  aiClassification   Json?
  // IA Copilot: resumo da conversa (1-2 frases). Regenerado on-demand ou após N msgs novas.
  aiSummary          String?            @db.Text
  aiSummaryAt        DateTime?
  // IA Copilot: próximas ações sugeridas pelo modelo. Schema: [{ kind: 'assign'|'move_card'|'apply_label'|'set_status'|'send_template', ...args, reason, confidence }]
  aiSuggestedActions Json?
  aiSuggestedAt      DateTime?
  // KB auto-suggest: artigo top-1 da base que melhor casa com a conversa (cosine sim).
  // Schema: { articleId, articleTitle, score: 0-1, suggestedAt: ISO }
  aiKbSuggestion         Json?
  aiKbSuggestionAt       DateTime?
  // accepted=true quando o agente inseriu o conteúdo e mandou — métrica de eficácia.
  aiKbSuggestionAccepted Boolean   @default(false)
  // CSAT/NPS pós-resolução: survey enviado + janela aguardando resposta.
  csatSurveyId              String?
  csatSentAt                DateTime?
  // Quando set + agora < deadline → próximo inbound conta como possível resposta.
  csatAwaitingResponseUntil DateTime?
  isAwaitingWelcomeChoice Boolean   @default(false)
  welcomeAttempts         Int       @default(0)
  welcomeFallbackSent     Boolean   @default(false)
  welcomeSentAt           DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox     Inbox               @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]
  labels    ConversationLabel[]
  notes     ConversationNote[]
  csatResponse CsatResponse?

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, status, lastInboundAt, lastOutboundAt])
  @@index([assignedAgentId])
  @@index([contactId])
  @@index([inboxId])
  @@index([workspaceId, aiKbSuggestionAccepted])
  @@index([csatAwaitingResponseUntil])
  @@map("conversations")
}

// ============================================
// CONVERSATION NOTES + TEMPLATES (Fase 4 follow-up)
// ============================================

model ConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

model MessageTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  // Atalho tipo /saudacao
  shortcut    String?
  // Suporta placeholders {{contact.name}}, {{contact.phoneNumber}}
  body        String   @db.Text
  // Quando setado, template aparece como botão direto no composer. Top 3 mais
  // recentes (pinnedAt desc) ficam visíveis pra agentes sem precisar digitar /shortcut.
  pinnedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, pinnedAt])
  @@map("message_templates")
}

// ============================================
// LABELS + CUSTOM ATTRIBUTES (Fase 5)
// ============================================

enum LabelScope {
  CONTACT
  CONVERSATION
  BOTH
}

model Label {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  color       String     @default("#94a3b8") // slate-400
  scope       LabelScope @default(BOTH)
  routesToFunnelId String?
  routesToStageId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactLabels      ContactLabel[]
  conversationLabels ConversationLabel[]
  cardLabels         CardLabel[]
  routesToFunnel Funnel? @relation("LabelRoutesToFunnel", fields: [routesToFunnelId], references: [id], onDelete: SetNull)
  routesToStage  Stage?  @relation("LabelRoutesToStage", fields: [routesToStageId], references: [id], onDelete: SetNull)
  welcomeOptionsAsTarget WelcomeOption[] @relation("WelcomeOptionLabel")
  welcomeFlowFallback    WelcomeFlow[]   @relation("WelcomeFlowFallbackLabel")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model ContactLabel {
  contactId String
  labelId   String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
  @@map("contact_labels")
}

model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
  @@map("conversation_labels")
}

enum CustomAttributeType {
  STRING
  NUMBER
  DATE
  SELECT
}

model CustomAttributeDef {
  id          String              @id @default(cuid())
  workspaceId String
  key         String // identificador estável (snake_case)
  label       String // human-readable
  type        CustomAttributeType @default(STRING)
  options     Json? // SELECT: { values: ["A", "B", "C"] }
  appliesTo   String              @default("CONTACT") // CONTACT, CONVERSATION
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_attribute_defs")
}

// ============================================
// KANBAN (Fase 6)
// ============================================

model Funnel {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  color         String   @default("#3b82f6")
  order         Int      @default(0)
  isDefault     Boolean  @default(false)
  // SLA limiares (segundos sem resposta agente) — override do default
  slaThresholds Json? // { yellow: 900, red: 1800, blink: 3600 }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  cards     Card[]
  routedFromLabels Label[] @relation("LabelRoutesToFunnel")
  welcomeOptionsAsTarget WelcomeOption[] @relation("WelcomeOptionFunnel")
  welcomeFlowFallback    WelcomeFlow[]   @relation("WelcomeFlowFallbackFunnel")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("funnels")
}

enum StageOutcome {
  POSITIVE // ganho — outcome final positivo (substitui isWon)
  NEGATIVE // perda — outcome final negativo (substitui isLost)
  RISK     // risco — alerta, card continua ativo (não fecha)
}

model Stage {
  id        String        @id @default(cuid())
  funnelId  String
  name      String
  color     String        @default("#94a3b8")
  order     Int           @default(0)
  outcome   StageOutcome?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  cards  Card[]
  routedFromLabels Label[] @relation("LabelRoutesToStage")
  welcomeOptionsAsTarget WelcomeOption[] @relation("WelcomeOptionStage")
  welcomeFlowFallback    WelcomeFlow[]   @relation("WelcomeFlowFallbackStage")

  @@index([funnelId])
  @@map("stages")
}

model Card {
  id                 String    @id @default(cuid())
  workspaceId        String
  funnelId           String
  stageId            String
  conversationId     String?
  title              String
  description        String?   @db.Text
  value              Decimal?  @db.Decimal(12, 2)
  currency           String    @default("USD")
  assignedAgentId    String?
  dueDate            DateTime?
  startDate          DateTime?
  position           Int       @default(0)
  customAttrs        Json?
  // SLA derivado — recalculado periodicamente
  slaStatus          String    @default("green") // green/yellow/red/blink
  lastAgentReplyAt   DateTime?
  // Última msg da conversa (cache pra preview no card)
  lastMessagePreview String?   @db.Text
  lastMessageAt      DateTime?
  unreadCount        Int       @default(0)
  // IA Forecast: probabilidade de fechamento (0.00-1.00) baseada em mensagens + valor + idade
  aiWinProbability   Decimal?  @db.Decimal(3, 2)
  // Raciocínio que IA usou pra estimar (1-2 frases pra agente entender)
  aiWinReasoning     String?   @db.Text
  aiForecastAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnel    Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stage     Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  labels    CardLabel[]
  products  CardProduct[]
  snoozes   CardSnooze[]
  notes     CardNote[]

  @@index([workspaceId])
  @@index([funnelId, stageId, position])
  @@index([conversationId])
  @@index([assignedAgentId])
  @@index([slaStatus])
  // NOTA: partial unique index "cards_conversationId_funnelId_active_uniq" existe
  // via raw SQL (migration add_cards_active_unique). Bloqueia 2 cards ativos
  // pra mesma conversa no mesmo funnel — fecha race em applyTagWithRouting.
  // Prisma não suporta partial uniques com predicate via @@unique.
  @@map("cards")
}

model CardLabel {
  cardId    String
  labelId   String
  createdAt DateTime @default(now())

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model CardProduct {
  id        String   @id @default(cuid())
  cardId    String
  name      String
  price     Decimal? @db.Decimal(12, 2)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("card_products")
}

model CardSnooze {
  id            String    @id @default(cuid())
  cardId        String
  snoozeUntil   DateTime
  reason        String?
  reactivatedAt DateTime?
  createdAt     DateTime  @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([snoozeUntil])
  @@map("card_snoozes")
}

model CardNote {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@map("card_notes")
}

// ============================================
// SAVED FILTERS (Fase 8)
// ============================================

model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  query       Json // serialização dos filtros
  context     String // 'inbox' ou 'kanban'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, workspaceId, context, name])
  @@index([userId])
  @@map("saved_filters")
}

enum MessageSender {
  CUSTOMER
  AGENT
  AI_AGENT
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum TranscriptionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  // ID retornado pelo Baileys (key.id) — único por sessão/jid (apenas inbox WHATSAPP)
  waMessageId    String?
  // ID retornado pelo Telegram Bot API (message_id é integer) — apenas inbox TELEGRAM
  telegramMessageId Int?
  // Header Message-ID do email (inbound parsed OU retornado por Resend send) —
  // apenas inbox EMAIL. Usado pra threading (In-Reply-To cliente lado, match inbound nosso lado).
  emailMessageId String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String?          @db.Text
  // Preenchido pra mídia (Fase 3 vai apontar pro MinIO)
  mediaUrl       String?
  mediaMimeType  String?
  mediaSize      Int?
  // Thumbnail 240x240 gerado pra imagens (sharp) — usado em preview/inbox
  thumbnailUrl   String?
  // Resposta a outra mensagem (replied_to no Baileys)
  replyToId      String?
  status         MessageStatus    @default(PENDING)
  // Transcrição (preenchido pra AUDIO via Whisper, fire-and-forget)
  transcription       String?              @db.Text
  transcriptionStatus TranscriptionStatus?
  // Edição: editedAt preenchido quando agente reedita conteúdo (Baileys edit API).
  // deletedAt preenchido quando msg foi revogada ("apagar pra todos") — content fica null/placeholder.
  editedAt       DateTime?
  deletedAt      DateTime?
  // Mensagem encaminhada — referência opcional à msg original (mesmo workspace).
  // Cliente WhatsApp NÃO marca como forwarded ao receber (só envia conteúdo).
  forwardedFromId String?
  // Location messages (Baileys locationMessage) — campos opcionais.
  locationLat    Float?
  locationLon    Float?
  locationName   String?
  locationAddress String?
  // Pin de mensagem na conversa (apenas interno — não propaga pro WhatsApp).
  // pinnedAt + pinnedBy permite N msgs pinadas, ordenadas por pinnedAt desc.
  pinnedAt       DateTime?
  pinnedBy       String?
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  senderType MessageSender @default(CUSTOMER)
  // Metadata flexivel JSON — usada pra interactive replies do Baileys (interactiveRowId,
  // interactiveDisplayText), transcript pos-Whisper, e outros campos opcionais que nao
  // merecem coluna dedicada. Schema-less por design.
  metadata   Json?

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  edits        MessageEdit[]

  @@index([conversationId, createdAt])
  @@index([conversationId, pinnedAt], map: "messages_conversationId_pinnedAt_idx")
  @@index([waMessageId])
  @@index([emailMessageId])
  @@map("messages")
}

// Snapshot de cada edição de mensagem: gravado ANTES do update, contém o
// content anterior + quem editou + quando. Renderizar histórico → ordem
// decrescente por editedAt. A versão "atual" é Message.content + editedAt.
model MessageEdit {
  id              String   @id @default(cuid())
  messageId       String
  previousContent String   @db.Text
  editedBy        String?
  editedAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt])
  @@map("message_edits")
}

model MessageReaction {
  id          String   @id @default(cuid())
  messageId   String
  emoji       String
  fromMe      Boolean  @default(true) // true = enviado por agente nosso
  createdBy   String?  // userId que reagiu (null = vindo do cliente)
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, fromMe])
  @@index([messageId])
  @@map("message_reactions")
}

// ============================================
// API KEYS (Bearer pra integrações externas)
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String    // ex 'nk_live_abc12345' — visível pro user identificar
  hashed      String    @unique // SHA-256 do segredo completo
  scopes      String[]  @default([])
  enabled     Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

// ============================================
// SCHEDULED MESSAGES (envios agendados)
// ============================================

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id             String                 @id @default(cuid())
  workspaceId    String
  conversationId String
  scheduledFor   DateTime
  type           MessageType            @default(TEXT)
  content        String?                @db.Text
  mediaUrl       String?
  mediaMimeType  String?
  fileName       String?
  status         ScheduledMessageStatus @default(PENDING)
  sentMessageId  String?                // Message.id criado ao disparar
  failedReason   String?                @db.Text
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status, scheduledFor])
  @@map("scheduled_messages")
}

// ============================================
// WEBHOOKS (Integrações externas — n8n, Zapier, etc.)
// ============================================

model Webhook {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  url         String
  events      String[] // ['message.new', 'conversation.created', 'card.moved', ...]
  secret      String?  // pra assinar payload com HMAC-SHA256
  enabled     Boolean   @default(true)
  lastFiredAt DateTime?
  lastStatus  Int?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("webhooks")
}

// ============================================
// INBOUND WEBHOOKS (POST externo dispara ação no Neura — CRM, n8n, IA externa)
// ============================================

model InboundWebhook {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  // slug é a parte da URL: /api/inbound/<slug>. Único por workspace.
  slug        String    @unique
  // HMAC-SHA256 secret pra validar X-Neura-Signature.
  secret      String
  enabled     Boolean   @default(true)
  // Quais actions essa rota pode disparar (subset de allowed actions).
  // Vazio = todas. Exemplos: ['send_message','create_note'].
  allowedActions String[] @default([])
  lastFiredAt DateTime?
  lastStatus  Int?
  lastError   String?   @db.Text
  callCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("inbound_webhooks")
}

// ============================================
// AUTOMATION RULES (regras "se X então Y")
// ============================================

model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  // 'auto': dispara por evento ou scheduler tempo. 'macro': só roda quando agente clica botão.
  kind        String   @default("auto")
  trigger     String   // 'conversation.created' | 'message.new' | 'card.moved' | 'time.no_response' | 'time.after_created' | 'manual' (pra macros)
  conditions  Json     // [{ field: 'message.text', op: 'contains', value: 'preço' }, ...]
  actions     Json     // [{ kind: 'assign_agent', userId: 'xxx' }, ...]
  // Config extra pra triggers tempo: {hoursThreshold: number}
  triggerConfig Json?
  enabled     Boolean  @default(true)
  priority    Int      @default(0) // maior = roda primeiro
  runCount    Int      @default(0)
  lastFiredAt DateTime?
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([workspaceId, trigger, enabled])
  @@index([workspaceId, kind])
  @@map("automation_rules")
}

// Histórico de execução das automation rules — uma linha por (rule, event).
// SKIPPED: conditions não passaram (rule não fez nada).
// MATCHED: conditions passaram + todas actions executaram OK.
// PARTIAL: conditions passaram mas alguma action falhou.
// FAILED:  erro fatal antes/durante actions.
enum AutomationRunStatus {
  MATCHED
  PARTIAL
  FAILED
  SKIPPED
}

model AutomationRun {
  id               String              @id @default(cuid())
  ruleId           String
  workspaceId      String
  trigger          String
  status           AutomationRunStatus
  // Recurso que disparou (ex: "Conversation:abc", "Card:xyz", "Message:def")
  resource         String?
  // [{ field, op, value, actual, matched }] — snapshot da avaliação
  conditionsResult Json?
  // [{ kind, status: 'ok'|'error', error?, durationMs }]
  actionsResult    Json?
  errorMessage     String?             @db.Text
  durationMs       Int?
  createdAt        DateTime            @default(now())

  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("automation_runs")
}

// ============================================
// SLA POLICIES (Fase 32)
// ============================================
// scope 'default' (workspace-wide) | 'inbox' (override por inbox.id) | 'label' (override por label.id)
// Thresholds em MINUTOS. FRT = primeira resposta. RT = resolução.
// Resolução: aplica primeiro label, depois inbox, depois default.

model SlaPolicy {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  scope       String   // 'default' | 'inbox' | 'label'
  scopeId     String?  // inbox.id ou label.id; null pra default
  firstResponseThresholdMin Int @default(15) // FRT alvo em minutos
  resolutionThresholdMin    Int @default(1440) // RT alvo em minutos (24h)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, scopeId])
  @@index([workspaceId])
  @@map("sla_policies")
}

// ============================================
// KNOWLEDGE BASE + RAG (Fase 34)
// ============================================
// Artigos de KB indexados por embedding (pgvector) pra busca semântica.
// Agente busca via composer no chat ("Buscar na base") — top-N artigos por
// cosine similarity são exibidos pra inserir conteúdo.
// A coluna `embedding vector(1536)` é adicionada via migration SQL bruta
// (Prisma 6 não suporta tipo vector nativamente — acesso via $queryRaw).
// HNSW index é criado na migration pra performance em volume.

model KbCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  color       String   @default("#6366f1") // indigo-500
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  KbArticle[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@map("kb_categories")
}

enum KbArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbArticle {
  id          String          @id @default(cuid())
  workspaceId String
  categoryId  String?
  title       String
  slug        String
  body        String          @db.Text
  // Primeiras N chars do body — cache pra search results sem ler body completo.
  excerpt     String?         @db.Text
  status      KbArticleStatus @default(DRAFT)
  viewCount   Int             @default(0)
  // Set quando embedding é re-gerado. Se NULL ou < updatedAt → enfileira re-embed.
  embeddingUpdatedAt DateTime?
  // pgvector embedding (1536 dims, OpenAI text-embedding-3-small). Unsupported
  // pois Prisma 6 não tem tipo nativo vector. Declarado pra Prisma reconhecer
  // a coluna + índice HNSW e parar de propor DROP em cada migrate dev.
  embedding Unsupported("vector(1536)")?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([categoryId])
  // NOTA: HNSW index kb_articles_embedding_hnsw_idx existe via raw SQL (phase34).
  // Prisma 6.19 ainda não suporta `type: Hnsw` no @@index — sempre vai propor
  // DROP em migrate dev. Strip a linha DROP do migration.sql gerado.
  @@map("kb_articles")
}

// ============================================
// CSAT + NPS (Fase 37 — Onda 8)
// ============================================
// Survey automático pós-RESOLVED. Múltiplos surveys por workspace (A/B test
// + variantes por canal). Resposta inbound (1-5 / 0-10 / emoji) é parseada
// e cria CsatResponse — 1 por conversa (unique).

enum CsatScoreType {
  CSAT   // 1-5 (estrelas)
  NPS    // 0-10 (likelihood to recommend)
  THUMBS // 0 ou 1 (negativo/positivo)
}

enum CsatChannelScope {
  ALL
  WHATSAPP
  TELEGRAM
  EMAIL
  WEBCHAT
}

model CsatSurvey {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  scoreType       CsatScoreType    @default(CSAT)
  channelScope    CsatChannelScope @default(ALL)
  delayMinutes    Int              @default(5)
  messageBody     String           @db.Text
  thankYouMessage String?          @db.Text
  enabled         Boolean          @default(true)
  isDefault       Boolean          @default(false)
  sentCount       Int              @default(0)
  responseCount   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses CsatResponse[]

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
  @@map("csat_surveys")
}

model CsatResponse {
  id             String        @id @default(cuid())
  workspaceId    String
  surveyId       String
  conversationId String        @unique
  contactId      String
  agentId        String?
  score          Int
  scoreType      CsatScoreType
  comment        String?       @db.Text
  sentAt         DateTime
  respondedAt    DateTime      @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey       CsatSurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, respondedAt])
  @@index([surveyId])
  @@index([agentId])
  @@map("csat_responses")
}

// ============================================
// NOTIFICATIONS (sino do topbar)
// ============================================

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  kind        String   // 'message.new' | 'conversation.assigned' | 'sla.critical' | 'card.outcome'
  title       String
  body        String?  @db.Text
  link        String?  // ex: /inbox/abc123
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

// ============================================
// WELCOME FLOW (Fase A — saudação interativa + auto-routing)
// ============================================

model WelcomeFlow {
  id                     String   @id @default(cuid())
  workspaceId            String
  inboxId                String   @unique
  prompt                 String   @db.Text
  fallbackLabelId        String?
  fallbackFunnelId       String?
  fallbackStageId        String?
  fallbackUserId         String?
  fallbackTimeoutMinutes Int      @default(2)
  maxAttempts            Int      @default(2)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox          Inbox           @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  fallbackLabel  Label?          @relation("WelcomeFlowFallbackLabel", fields: [fallbackLabelId], references: [id], onDelete: SetNull)
  fallbackFunnel Funnel?         @relation("WelcomeFlowFallbackFunnel", fields: [fallbackFunnelId], references: [id], onDelete: SetNull)
  fallbackStage  Stage?          @relation("WelcomeFlowFallbackStage", fields: [fallbackStageId], references: [id], onDelete: SetNull)
  fallbackUser   User?           @relation("WelcomeFlowFallbackUser", fields: [fallbackUserId], references: [id], onDelete: SetNull)
  options        WelcomeOption[]

  @@index([workspaceId])
  @@map("welcome_flows")
}

model WelcomeOption {
  id              String   @id @default(cuid())
  flowId          String
  position        Int
  label           String
  description     String?
  matchKeywords   String[]
  targetLabelId   String
  targetFunnelId  String?
  targetStageId   String?
  targetUserId    String?
  createdAt       DateTime @default(now())

  flow         WelcomeFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  targetLabel  Label       @relation("WelcomeOptionLabel", fields: [targetLabelId], references: [id], onDelete: Restrict)
  targetFunnel Funnel?     @relation("WelcomeOptionFunnel", fields: [targetFunnelId], references: [id], onDelete: SetNull)
  targetStage  Stage?      @relation("WelcomeOptionStage", fields: [targetStageId], references: [id], onDelete: SetNull)
  targetUser   User?       @relation("WelcomeOptionTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@unique([flowId, position])
  @@index([flowId])
  @@map("welcome_options")
}
